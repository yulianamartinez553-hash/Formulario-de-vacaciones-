{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/rrhh", "permanent": false },
    { "source": "/control", "destination": "/rrhh", "permanent": false },
    { "source": "/control_vacaciones_servinorte.html", "destination": "/rrhh", "permanent": false }
  ],
  "rewrites": [],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
